# Lido por dotenv.config() ao rodar a API fora do Docker (npm run dev / npm start).
# O .env da raiz é outro arquivo, com outras chaves, e serve ao docker-compose.

# ---- Banco (MariaDB local) ----
DATABASE=school_local
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=<senha-do-banco-local>

# ---- Auth ----
ACCESS_TOKEN_SECRET=<gere-um-segredo-forte>
ACCESS_TOKEN_EXPIRATION=604800

# ---- API ----
APP_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
APP_PORT=3001
LOG_LEVEL=debug

# ---- Demo (perfil read-only) ----
DEMO_USER_EMAIL=demo@sisbodeveloper.com.br
DEMO_USER_PASSWORD=<senha-demo>
DEMO_LEVEL_ID=99
