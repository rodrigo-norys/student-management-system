# ---- Banco (MariaDB) ----
DB_NAME=school_local
DB_USER=app
DB_PASSWORD=<defina-uma-senha-do-app>
DB_ROOT_PASSWORD=<defina-uma-senha-root>

# ---- API (backend) ----
API_URL=https://api.localhost
ACCESS_TOKEN_SECRET=<gere-um-segredo-forte>
ACCESS_TOKEN_EXPIRATION=604800

CORS_ORIGINS=https://localhost,https://api.localhost
DEMO_USER_EMAIL=demo@sisbodeveloper.com.br
DEMO_USER_PASSWORD=<senha-demo>
DEMO_LEVEL_ID=99
LOG_LEVEL=info

# ---- Frontend (build-time) ----
REACT_APP_API_URL=https://api.localhost

# ---- Caddy (borda) ----
SITE_DOMAIN=localhost
API_DOMAIN=api.localhost
ACME_EMAIL=dev@localhost
